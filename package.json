{
  "name": "gestao-tecnica-nonato-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "build:demo": "node scripts/run-next-build-demo.mjs",
    "start": "node scripts/start-server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "apply-layout": "node apply-layout-criacao-checklist.js",
    "homag:import": "node scripts/homag-import/run.mjs",
    "homag:merge": "node scripts/homag-import/merge-export-para-biblioteca.mjs",
    "homag:import-tudo": "node scripts/homag-import/run.mjs && node scripts/homag-import/merge-export-para-biblioteca.mjs",
    "homag:import:probe": "node scripts/homag-import/probe-selectors.mjs",
    "restaurar:cadastro": "node scripts/restaurar-cadastro-servicos.mjs",
    "restaurar:dados": "node scripts/restaurar-dados-backup.mjs",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "i18n:sync": "node scripts/sync-i18n-full.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "jszip": "^3.10.1",
    "next": "^14.0.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^7.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "google-translate-api-x": "^10.7.3",
    "playwright": "^1.49.0",
    "typescript": "^5.0.0"
  }
}
