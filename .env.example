# Variáveis opcionais — copie para .env ou configure no Railway

# Pasta de dados no servidor (Railway volume)
# RAILWAY_VOLUME_MOUNT_PATH=/data
# DATA_DIR=./data

# Segurança API (recomendado em produção)
# Quando definido, bloqueia gravações /api/data/* e restauro de código por origens externas.
# O browser acede normalmente pelo mesmo domínio; scripts externos precisam do header X-Nonato-Api-Key.
# NONATO_MASTER_PASSWORD=23093110
# (temporário) Permite entrar com esta senha mesmo que a senha guardada no servidor seja outra.
# Remova depois de entrar e definir a senha correcta no Administrador.

# NONATO_EMERGENCY_KEY=uma-chave-secreta-longa
# Permite chamar POST /api/auth/emergency-reset para redefinir a senha no volume Railway.

# Backup de código — histórico PowerShell/terminal (desactivado por defeito)
# NONATO_BACKUP_INCLUDE_COMMAND_HISTORY=1

# Raiz do projecto para backup de código (opcional — recomendado no PC local)
# BACKUP_PROJECT_ROOT=C:\Users\W10\gestao-tecnica-nonato-service

# URL pública da app (opcional — Railway preenche RAILWAY_PUBLIC_DOMAIN automaticamente)
# Use se redirects (ex.: /demo) forem para 0.0.0.0 em vez do domínio público.
# NONATO_PUBLIC_URL=https://gest-o-nonato-gestao.up.railway.app
