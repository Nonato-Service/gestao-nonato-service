# Exemplo — modo hub local (PC + tablet na mesma Wi‑Fi)
# Não é obrigatório: INICIAR-NONATO-LOCAL.bat já define estas variáveis.
# Se quiser usar ficheiro .env.local, copie este conteúdo para .env.local
# (o ficheiro .env.local não deve ser commitado).

# Pasta de dados no disco do PC (nunca apontar para pasta vazia que vá sobrescrever cadastros)
DATA_DIR=./data-local

# Escutar em todas as interfaces (tablet na LAN)
HOSTNAME=0.0.0.0
PORT=3000

# Produção local (npm start / start-server.js)
# NODE_ENV=production
